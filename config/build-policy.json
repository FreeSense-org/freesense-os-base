{
  "schema_version": "freesense.build-policy/v4",
  "package_train": "1.1",
  "release": {
    "stable_train": "1.0",
    "development_train": "1.1",
    "development_version": "1.1.0",
    "stable_lifecycle": "supported",
    "development_lifecycle": "experimental",
    "allow_stable_to_development": true,
    "allow_development_to_stable": false
  },
  "default_target": "amd64",
  "default_image_profiles": {
    "amd64": "generic-amd64",
    "arm64": "generic-arm64-uefi"
  },
  "release_profile_sets": {
    "amd64": ["generic-amd64"],
    "arm64": ["generic-arm64-uefi", "arm64-rpi4b", "arm64-rpi5-d0"]
  },
  "targets": {
    "amd64": {
      "architecture": "amd64",
      "freebsd_target": "amd64",
      "freebsd_target_arch": "amd64",
      "package_arch": "amd64",
      "poudriere_arch": "amd64.amd64",
      "abi": "FreeBSD:16:amd64",
      "altabi": "freebsd:16:x86:64",
      "kernel": "FreeSense",
      "executor": "native-amd64",
      "build_enabled": true,
      "publish_enabled": true
    },
    "arm64": {
      "architecture": "arm64",
      "freebsd_target": "arm64",
      "freebsd_target_arch": "aarch64",
      "package_arch": "aarch64",
      "poudriere_arch": "arm64.aarch64",
      "abi": "FreeBSD:16:aarch64",
      "altabi": "freebsd:16:aarch64:64",
      "kernel": "FreeSense",
      "executor": "amd64-cross-qemu-user",
      "build_enabled": true,
      "publish_enabled": true
    }
  },
  "image_profiles": {
    "generic-amd64": {
      "target": "amd64",
      "platform": "generic-amd64",
      "partition_scheme": "gpt",
      "firmware": ["bios", "uefi"],
      "installer": "iso",
      "filesystems": ["ufs", "zfs"],
      "formats": ["qcow2", "raw"],
      "devices": ["virtio-blk", "virtio-net"],
      "capabilities": {"bios": true, "uefi": true, "iso": true, "installer_img": false, "cloud_init": true},
      "variants": {
      "ufs": {
        "virtual_size_gib": 16,
        "root_growth": true
      },
      "zfs": {
        "virtual_size_gib": 32,
        "root_growth": true,
        "pool": "FreeSense",
        "root_dataset": "FreeSense/ROOT/default",
        "topology": "stripe",
        "boot_environments": true,
        "autotrim": false
      }
      }
    },
    "generic-arm64-uefi": {
      "target": "arm64",
      "platform": "generic-arm64-uefi",
      "partition_scheme": "gpt",
      "firmware": ["uefi"],
      "installer": "img",
      "filesystems": [],
      "formats": [],
      "devices": ["virtio-blk", "virtio-net"],
      "capabilities": {"bios": false, "uefi": true, "iso": false, "installer_img": true, "cloud_init": false},
      "variants": {}
    },
    "arm64-rpi4b": {
      "target": "arm64",
      "platform": "arm64-rpi4b",
      "kind": "appliance",
      "partition_scheme": "mbr",
      "firmware": ["raspberry-pi-firmware", "u-boot"],
      "installer": "none",
      "filesystem": "ufs",
      "format": "img",
      "compression": "xz",
      "filesystems": [],
      "formats": [],
      "devices": ["bcm2711", "sd", "usb", "genet", "axge"],
      "target_models": ["Raspberry Pi 4 Model B"],
      "boot_partition": {"filesystem": "fat16", "size_mib": 50},
      "boot_inputs": {
        "provider": "FreeBSD",
        "recipe": "release/arm64/RPI.conf",
        "ports": ["sysutils/u-boot-rpi-arm64", "sysutils/rpi-firmware"]
      },
      "capabilities": {"bios": false, "uefi": false, "u_boot": true, "iso": false, "installer_img": false, "appliance": true, "cloud_init": false, "root_growth": true, "serial_console": true, "hdmi_console": true},
      "variants": {}
    },
    "arm64-rpi5-d0": {
      "target": "arm64",
      "platform": "arm64-rpi5-d0",
      "kind": "appliance",
      "partition_scheme": "mbr",
      "firmware": ["raspberry-pi", "uefi"],
      "installer": "none",
      "filesystem": "ufs",
      "format": "img",
      "compression": "xz",
      "filesystems": [],
      "formats": [],
      "devices": ["bcm2712-d0", "sd", "usb", "axge", "ure"],
      "target_models": ["Raspberry Pi 5 Model B (BCM2712 D0)"],
      "boot_partition": {"filesystem": "fat32", "size_mib": 260},
      "minimum_eeprom_date": "2025-06-09",
      "boot_inputs": {
        "provider": "NumberOneGit/rpi5-uefi",
        "version": "v0.1",
        "commit": "510c68e95515168bb74a4afb1932b63fb437d014",
        "url": "https://github.com/NumberOneGit/rpi5-uefi/releases/download/v0.1/RPI5_D0.zip",
        "archive_sha256": "c4fbbec9cd0d1115c9adab884923061b960de42b4ca6d65ba5f08cb6b46c6fad",
        "dtbs": ["bcm2712-d-rpi-5-b.dtb", "bcm2712-rpi-5-b.dtb", "bcm2712d0-rpi-5-b.dtb"],
        "redistribution_review": "pending"
      },
      "capabilities": {"bios": false, "uefi": true, "u_boot": false, "iso": false, "installer_img": false, "appliance": true, "cloud_init": false, "root_growth": true, "serial_console": true, "hdmi_console": true, "onboard_networking": false},
      "variants": {}
    }
  },
  "public_base_url": "https://pkg.freesense.org/v1",
  "stable_soak_hours": 168,
  "runner": {
    "vcpus": 12,
    "memory_mib": 32768,
    "disk_gib": 160
  }
}
