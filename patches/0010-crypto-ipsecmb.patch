+/* ------------------------------------------------------------------ */
+/* Device                                                              */
+/* ------------------------------------------------------------------ */
+
+static void
+ipsecmb_identify(driver_t *driver, device_t parent)
+{
+	if (device_find_child(parent, "ipsecmb", DEVICE_UNIT_ANY) == NULL)
+		BUS_ADD_CHILD(parent, 10, "ipsecmb", DEVICE_UNIT_ANY);
+}
+
+static int
+ipsecmb_probe(device_t dev)
+{
+	/* The library's lowest level (SSE) needs SSE4.2, AES-NI and PCLMULQDQ. */
+	if ((cpu_feature2 & (CPUID2_SSE42 | CPUID2_AESNI | CPUID2_PCLMULQDQ)) !=
+	    (CPUID2_SSE42 | CPUID2_AESNI | CPUID2_PCLMULQDQ)) {
+		device_printf(dev, "needs SSE4.2, AES-NI and PCLMULQDQ\n");
+		return (ENXIO);
+	}
+	device_set_desc(dev, "Intel IPsec-MB multi-buffer crypto");
+	return (BUS_PROBE_DEFAULT);
+}
+
+static void ipsecmb_stop_workers(struct ipsecmb_softc *sc);
+
+static int
+ipsecmb_sysctl_counter(SYSCTL_HANDLER_ARGS)
+{
+	counter_u64_t c = *(counter_u64_t *)arg1;
+	uint64_t v;
+
+	v = counter_u64_fetch(c);
+	return (sysctl_handle_64(oidp, &v, 0, req));
+}
+
+static void
+ipsecmb_sysctls(struct ipsecmb_softc *sc)
+{
+	struct sysctl_ctx_list *ctx = device_get_sysctl_ctx(sc->dev);
+	struct sysctl_oid_list *children = SYSCTL_CHILDREN(device_get_sysctl_tree(sc->dev));
+
+	SYSCTL_ADD_CONST_STRING(ctx, children, OID_AUTO, "arch", CTLFLAG_RD,
+	    ipsecmb_arch_name(sc->arch), "Instruction set in use");
+	SYSCTL_ADD_CONST_STRING(ctx, children, OID_AUTO, "library", CTLFLAG_RD,
+	    imb_get_version_str(), "intel-ipsec-mb version");
+	SYSCTL_ADD_INT(ctx, children, OID_AUTO, "workers", CTLFLAG_RD,
+	    &sc->nworkers, 0, "Worker threads");
+	SYSCTL_ADD_INT(ctx, children, OID_AUTO, "last_status", CTLFLAG_RD,
+	    &sc->last_status, 0, "IMB_STATUS of the last failed job");
+	SYSCTL_ADD_INT(ctx, children, OID_AUTO, "last_errno", CTLFLAG_RD,
+	    &sc->last_errno, 0, "Library error code after the last failed job");
+	SYSCTL_ADD_PROC(ctx, children, OID_AUTO, "jobs", CTLTYPE_U64 | CTLFLAG_RD | CTLFLAG_MPSAFE,
+	    &sc->jobs, 0, ipsecmb_sysctl_counter, "QU", "Jobs submitted");
+	SYSCTL_ADD_PROC(ctx, children, OID_AUTO, "flushes", CTLTYPE_U64 | CTLFLAG_RD | CTLFLAG_MPSAFE,
+	    &sc->flushes, 0, ipsecmb_sysctl_counter, "QU", "Job manager flushes");
+	SYSCTL_ADD_PROC(ctx, children, OID_AUTO, "bounces", CTLTYPE_U64 | CTLFLAG_RD | CTLFLAG_MPSAFE,
+	    &sc->bounces, 0, ipsecmb_sysctl_counter, "QU", "Requests copied to a bounce buffer");
+	SYSCTL_ADD_PROC(ctx, children, OID_AUTO, "errors", CTLTYPE_U64 | CTLFLAG_RD | CTLFLAG_MPSAFE,
+	    &sc->errors, 0, ipsecmb_sysctl_counter, "QU", "Requests finished with an error (other than a failed verification)");
+	SYSCTL_ADD_PROC(ctx, children, OID_AUTO, "enomem", CTLTYPE_U64 | CTLFLAG_RD | CTLFLAG_MPSAFE,
+	    &sc->enomem, 0, ipsecmb_sysctl_counter, "QU", "Requests refused for lack of memory");
+	SYSCTL_ADD_PROC(ctx, children, OID_AUTO, "auth_failures", CTLTYPE_U64 | CTLFLAG_RD | CTLFLAG_MPSAFE,
+	    &sc->auth_failures, 0, ipsecmb_sysctl_counter, "QU", "Requests whose tag or digest did not verify");
+}
+
+static int
+ipsecmb_attach(device_t dev)
+{
+	struct ipsecmb_softc *sc = device_get_softc(dev);
+	struct ipsecmb_worker *w;
+	int error, i;
+
+	sc->dev = dev;
+	mtx_init(&sc->setup_mtx, "ipsecmb setup", NULL, MTX_DEF);
+	sc->jobs = counter_u64_alloc(M_WAITOK);
+	sc->flushes = counter_u64_alloc(M_WAITOK);
+	sc->bounces = counter_u64_alloc(M_WAITOK);
+	sc->errors = counter_u64_alloc(M_WAITOK);
+	sc->enomem = counter_u64_alloc(M_WAITOK);
+	sc->auth_failures = counter_u64_alloc(M_WAITOK);
+	sc->req_zone = uma_zcreate("ipsecmb_req", sizeof(struct ipsecmb_req),
+	    NULL, NULL, NULL, NULL, UMA_ALIGN_CACHE, 0);
+
+	sc->setup_mem = ipsecmb_mgr_alloc();
+	fpu_kern_enter(curthread, NULL, FPU_KERN_NOCTX);
+	sc->setup_mgr = ipsecmb_mgr_init(sc, sc->setup_mem, &sc->arch);
+	if (sc->setup_mgr != NULL)
+		sc->features = sc->setup_mgr->features;
+	fpu_kern_leave(curthread, NULL);
+	if (sc->setup_mgr == NULL) {
+		device_printf(dev, "job manager init or self-test failed\n");
+		error = ENXIO;
+		goto fail;
+	}
+
+	sc->nworkers = mp_ncpus;
+	if (ipsecmb_threads_tunable > 0 && ipsecmb_threads_tunable < sc->nworkers)
+		sc->nworkers = ipsecmb_threads_tunable;
+	sc->workers = malloc(sizeof(*sc->workers) * sc->nworkers, M_IPSECMB,
+	    M_WAITOK | M_ZERO);
+	for (i = 0; i < sc->nworkers; i++) {
+		w = &sc->workers[i];
+		w->sc = sc;
+		w->cpu = i;
+		mtx_init(&w->mtx, "ipsecmb worker", NULL, MTX_DEF);
+		STAILQ_INIT(&w->queue);
+		error = kthread_add(ipsecmb_worker_main, w, NULL, &w->td, 0,
+		    IPSECMB_KSTACK_PAGES, "ipsecmb%d", i);
+		if (error != 0) {
+			device_printf(dev, "cannot start worker %d: %d\n", i, error);
+			w->td = NULL;
+			goto fail;
+		}
+		mtx_lock(&w->mtx);
+		while (!w->ready)
+			msleep(&w->ready, &w->mtx, 0, "imbinit", 0);
+		mtx_unlock(&w->mtx);
+		if (!w->running) {
+			error = ENXIO;
+			goto fail;
+		}
+	}
+
+	sc->cid = crypto_get_driverid(dev, sizeof(struct ipsecmb_session),
+	    CRYPTOCAP_F_SOFTWARE | CRYPTOCAP_F_ACCEL_SOFTWARE);
+	if (sc->cid < 0) {
+		device_printf(dev, "failed to allocate crypto driver id\n");
+		error = ENXIO;
+		goto fail;
+	}
+	ipsecmb_sysctls(sc);
+	device_printf(dev, "intel-ipsec-mb %s, %s, %d worker%s\n",
+	    imb_get_version_str(), ipsecmb_arch_name(sc->arch), sc->nworkers,
+	    sc->nworkers == 1 ? "" : "s");
+	return (0);
+
+fail:
+	ipsecmb_stop_workers(sc);
+	ipsecmb_mgr_free(sc->setup_mem);
+	sc->setup_mem = NULL;
+	uma_zdestroy(sc->req_zone);
+	counter_u64_free(sc->jobs);
+	counter_u64_free(sc->flushes);
+	counter_u64_free(sc->bounces);
+	counter_u64_free(sc->errors);
+	counter_u64_free(sc->enomem);
+	counter_u64_free(sc->auth_failures);
+	mtx_destroy(&sc->setup_mtx);
+	return (error);
+}
+
+static void
+ipsecmb_stop_workers(struct ipsecmb_softc *sc)
+{
+	struct ipsecmb_worker *w;
+	int i;
+
+	if (sc->workers == NULL)
+		return;
+	for (i = 0; i < sc->nworkers; i++) {
+		w = &sc->workers[i];
+		if (!mtx_initialized(&w->mtx))
+			continue;
+		mtx_lock(&w->mtx);
+		w->stop = true;
+		wakeup(w);
+		while (w->td != NULL)
+			msleep(&w->td, &w->mtx, 0, "imbstop", 0);
+		mtx_unlock(&w->mtx);
+		mtx_destroy(&w->mtx);
+	}
+	free(sc->workers, M_IPSECMB);
+	sc->workers = NULL;
+}
+
+static int
+ipsecmb_detach(device_t dev)
+{
+	struct ipsecmb_softc *sc = device_get_softc(dev);
+
+	crypto_unregister_all(sc->cid);
+	ipsecmb_stop_workers(sc);
+	ipsecmb_mgr_free(sc->setup_mem);
+	sc->setup_mem = NULL;
+	uma_zdestroy(sc->req_zone);
+	counter_u64_free(sc->jobs);
+	counter_u64_free(sc->flushes);
+	counter_u64_free(sc->bounces);
+	counter_u64_free(sc->errors);
+	counter_u64_free(sc->enomem);
+	counter_u64_free(sc->auth_failures);
+	mtx_destroy(&sc->setup_mtx);
+	return (0);
+}
+
+/* alloc.c's free_mb_mgr() is never called: the managers live in driver memory. */
+void ipsecmb_lib_free(void *ptr);
+void *ipsecmb_lib_memalign(size_t align, size_t size);
+
+void
+ipsecmb_lib_free(void *ptr)
+{
+	panic("ipsecmb: library free() called");
+}
+
+void *
+ipsecmb_lib_memalign(size_t align, size_t size)
+{
+	return (NULL);
+}
+
+static device_method_t ipsecmb_methods[] = {
+	DEVMETHOD(device_identify,	ipsecmb_identify),
+	DEVMETHOD(device_probe,		ipsecmb_probe),
+	DEVMETHOD(device_attach,	ipsecmb_attach),
+	DEVMETHOD(device_detach,	ipsecmb_detach),
+
+	DEVMETHOD(cryptodev_probesession, ipsecmb_probesession),
+	DEVMETHOD(cryptodev_newsession,	ipsecmb_newsession),
+	DEVMETHOD(cryptodev_freesession, ipsecmb_freesession),
+	DEVMETHOD(cryptodev_process,	ipsecmb_process),
+
+	DEVMETHOD_END
+};
+
+static driver_t ipsecmb_driver = {
+	"ipsecmb",
+	ipsecmb_methods,
+	sizeof(struct ipsecmb_softc)
+};
+
+DRIVER_MODULE(ipsecmb, nexus, ipsecmb_driver, NULL, NULL);
+MODULE_VERSION(ipsecmb, 1);
+MODULE_DEPEND(ipsecmb, crypto, 1, 1, 1);
diff --git a/sys/modules/ipsecmb/Makefile b/sys/modules/ipsecmb/Makefile
new file mode 100644
index 0000000..e0fad31
--- /dev/null
+++ b/sys/modules/ipsecmb/Makefile
@@ -0,0 +1,64 @@
+# ipsecmb(4): an OpenCrypto driver on Intel's multi-buffer crypto library.
+#
+# The library (sys/contrib/intel-ipsec-mb, fetched at a pinned commit by
+# freesense-os-base apply.sh) is built into the module: its NASM sources with
+# nasm, its C sources with the kernel flags minus the ones that forbid SIMD.
+# All library code runs only in an FPU context (the worker threads use
+# fpu_kern_thread(), key setup uses fpu_kern_enter()), so SIMD is safe there.
+# sources.mk lists the library's own objects (generated from its lib/Makefile).
+
+.PATH:	${SRCTOP}/sys/crypto/ipsecmb
+
+KMOD=	ipsecmb
+SRCS=	bus_if.h cryptodev_if.h device_if.h ipsecmb.c
+
+IPSECMB_LIB?=	${SRCTOP}/sys/contrib/intel-ipsec-mb/lib
+IPSECMB_COMPAT=	${SRCTOP}/sys/crypto/ipsecmb/compat
+# freesense-os-base scripts/kernel-contrib.sh builds the pinned nasm here.
+.if exists(${IPSECMB_LIB}/../.nasm/nasm)
+IPSECMB_NASM?=	${IPSECMB_LIB}/../.nasm/nasm
+.else
+IPSECMB_NASM?=	nasm
+.endif
+
+.include "${.CURDIR}/sources.mk"
+
+CFLAGS+=	-I${IPSECMB_LIB} -I${IPSECMB_COMPAT}
+
+# The library's own build options (lib/Makefile): all safety options on.
+IPSECMB_DEFS=	-DLINUX -DSAFE_DATA -DSAFE_PARAM -DSAFE_LOOKUP
+IPSECMB_NASMFLAGS= -Werror -felf64 -Xgnu -D__linux__ ${IPSECMB_DEFS} -I${IPSECMB_LIB}/
+IPSECMB_CFLAGS=	${CFLAGS:N-mno-mmx:N-mno-sse:N-msoft-float:N-mno-aes:N-mno-avx:N-Werror:N-Wmissing-prototypes:N-Wstrict-prototypes:N-Wcast-qual:N-Wundef} \
+		${IPSECMB_DEFS} -DAVX_IFMA -DSMX_NI \
+		-I${IPSECMB_LIB}/include -isystem ${:!${CC} -print-resource-dir!}/include \
+		-Wno-unused-parameter -Wno-sign-compare -Wno-unused-function -Wno-unused-variable
+
+IPSECMB_OPT_X86_64=	-msse4.2
+IPSECMB_OPT_SSE_T1=	-march=nehalem -maes -mpclmul
+IPSECMB_OPT_SSE_T2=	${IPSECMB_OPT_SSE_T1}
+IPSECMB_OPT_SSE_T3=	${IPSECMB_OPT_SSE_T1}
+IPSECMB_OPT_AVX2_T1=	-march=haswell -maes -mpclmul
+IPSECMB_OPT_AVX2_T2=	${IPSECMB_OPT_AVX2_T1}
+IPSECMB_OPT_AVX2_T3=	${IPSECMB_OPT_AVX2_T1}
+IPSECMB_OPT_AVX2_T4=	${IPSECMB_OPT_AVX2_T1}
+IPSECMB_OPT_AVX512_T1=	-march=broadwell -maes -mpclmul
+IPSECMB_OPT_AVX512_T2=	${IPSECMB_OPT_AVX512_T1}
+
+# free_mb_mgr()/alloc_mb_mgr() in alloc.c are never called; see ipsecmb.c.
+IPSECMB_CFLAGS.alloc.c=	-Dfree=ipsecmb_lib_free -Dmemalign=ipsecmb_lib_memalign -Wno-macro-redefined
+
+.for _d in X86_64 SSE_T1 SSE_T2 SSE_T3 AVX2_T1 AVX2_T2 AVX2_T3 AVX2_T4 AVX512_T1 AVX512_T2
+.for _s in ${IPSECMB_ASM_${_d}}
+${_s:T:R}.o: ${IPSECMB_LIB}/${_s}
+	${IPSECMB_NASM} ${IPSECMB_NASMFLAGS} -o ${.TARGET} ${IPSECMB_LIB}/${_s}
+OBJS+=	${_s:T:R}.o
+.endfor
+.for _s in ${IPSECMB_C_${_d}}
+${_s:T:R}.o: ${IPSECMB_LIB}/${_s}
+	${CC} -c ${IPSECMB_CFLAGS} ${IPSECMB_OPT_${_d}} ${IPSECMB_CFLAGS.${_s:T}} \
+	    -o ${.TARGET} ${IPSECMB_LIB}/${_s}
+OBJS+=	${_s:T:R}.o
+.endfor
+.endfor
+
+.include <bsd.kmod.mk>
