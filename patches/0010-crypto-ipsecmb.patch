+
+/*
+ * ipsecmb: an asynchronous OpenCrypto driver on Intel's multi-buffer crypto
+ * library (intel-ipsec-mb, sys/contrib/intel-ipsec-mb).
+ *
+ * The library processes several independent buffers at once in the SIMD
+ * lanes of one core. To give it several buffers, requests are not processed
+ * in the caller's context: cryptodev_process() queues them for a worker
+ * thread bound to the caller's CPU. The worker owns one IMB_MGR and an FPU
+ * context for its whole life, feeds the queued requests to the job manager,
+ * and finishes the jobs the manager hands back. When its queue runs dry it
+ * flushes the manager (or first waits flush_usec for more work, if set), so
+ * batches form under load and a lone packet is not held back.
+ *
+ * Supported: AES-GCM and ChaCha20-Poly1305 (AEAD), AES-CBC with HMAC-SHA1/
+ * SHA2-256/384/512 (ETA, also with a separate ESN), AES-CBC alone and the
+ * HMACs alone.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/bus.h>
+#include <sys/counter.h>
+#include <sys/kernel.h>
+#include <sys/kthread.h>
+#include <sys/lock.h>
+#include <sys/malloc.h>
+#include <sys/module.h>
+#include <sys/mutex.h>
+#include <sys/proc.h>
+#include <sys/queue.h>
+#include <sys/sched.h>
+#include <sys/smp.h>
+#include <sys/sysctl.h>
+
+#include <vm/uma.h>
+
+#include <machine/fpu.h>
+#include <machine/md_var.h>
+#include <machine/specialreg.h>
+
+#include <opencrypto/cryptodev.h>
+
+#include <intel-ipsec-mb.h>
+
+#include "cryptodev_if.h"
+
+static MALLOC_DEFINE(M_IPSECMB, "ipsecmb", "Intel IPsec-MB crypto");
+
+/* Library threads get a larger stack: some AVX-512 routines keep big frames. */
+#define	IPSECMB_KSTACK_PAGES	8
+#define	IPSECMB_ESN_LEN		4
+#define	IPSECMB_AAD_INLINE	64
+#define	IPSECMB_TAG_MAX		IMB_SHA512_DIGEST_SIZE_IN_BYTES
+#define	IPSECMB_GCM_TAG_LEN	16
+#define	IPSECMB_MAX_LEN		65535	/* MB_MAX_LEN16: CBC and HMAC job limit */
+
+static SYSCTL_NODE(_hw, OID_AUTO, ipsecmb, CTLFLAG_RD | CTLFLAG_MPSAFE, 0,
+    "Intel IPsec-MB crypto driver");
+
+static int ipsecmb_arch_tunable = 0;
+SYSCTL_INT(_hw_ipsecmb, OID_AUTO, arch, CTLFLAG_RDTUN, &ipsecmb_arch_tunable, 0,
+    "Instruction set: 0 best available, 1 SSE, 2 AVX2, 3 AVX-512");
+static int ipsecmb_threads_tunable = 0;
+SYSCTL_INT(_hw_ipsecmb, OID_AUTO, threads, CTLFLAG_RDTUN, &ipsecmb_threads_tunable, 0,
+    "Worker threads (0: one per CPU)");
+static int ipsecmb_sync = 0;
+SYSCTL_INT(_hw_ipsecmb, OID_AUTO, sync, CTLFLAG_RWTUN, &ipsecmb_sync, 0,
+    "Debug: flush the job manager after every request (no batching)");
+/*
+ * 0 (default): flush as soon as the queue is empty. Batches still form
+ * whenever requests arrive faster than a worker drains them, and a quiet flow
+ * is never held back. A wait (in microseconds) trades latency for fuller
+ * batches; it depends on the event timer and hurt CBC+HMAC badly in tests.
+ */
+static int ipsecmb_flush_usec = 0;
+SYSCTL_INT(_hw_ipsecmb, OID_AUTO, flush_usec, CTLFLAG_RWTUN, &ipsecmb_flush_usec, 0,
+    "How long an idle worker waits for more work before flushing (microseconds, 0: flush at once)");
+
+/* Expanded keys: separately allocated so they can be 64-byte aligned. */
+struct ipsecmb_keys {
+	struct gcm_key_data	gcm __aligned(64);
+	uint32_t		enc[60] __aligned(64);
+	uint32_t		dec[60] __aligned(64);
+	uint8_t			chacha[32] __aligned(64);
+	uint8_t			ipad[IMB_SHA512_DIGEST_SIZE_IN_BYTES] __aligned(64);
+	uint8_t			opad[IMB_SHA512_DIGEST_SIZE_IN_BYTES] __aligned(64);
+};
+
+struct ipsecmb_session {
+	struct ipsecmb_keys	*keys;
+	void			*keys_mem;
+	IMB_CIPHER_MODE		cipher_mode;
+	IMB_HASH_ALG		hash_alg;
+	int			mode;		/* CSP_MODE_* */
+	int			esn;		/* CSP_F_ESN */
+	u_int			key_len;
+	u_int			mlen;
+};
+
+struct ipsecmb_req {
+	uint8_t			tag[IPSECMB_TAG_MAX] __aligned(16);
+	uint8_t			iv[16] __aligned(16);
+	uint8_t			aad_inline[IPSECMB_AAD_INLINE] __aligned(16);
+	STAILQ_ENTRY(ipsecmb_req) link;
+	struct cryptop		*crp;
+	struct ipsecmb_session	*ses;
+	struct ipsecmb_keys	*keys;		/* session or per-request keys */
+	void			*tmpkeys_mem;	/* per-request keys */
+	uint8_t			*bounce;	/* [aad][payload][esn] copy */
+	size_t			bounce_len;
+	uint8_t			*aad_alloc;
+	int			bounce_payload_off;
+};
+
+STAILQ_HEAD(ipsecmb_reqq, ipsecmb_req);
+
+struct ipsecmb_worker {
+	struct mtx		mtx;
+	struct ipsecmb_reqq	queue;
+	IMB_MGR			*mgr;
+	void			*mgr_mem;
+	struct thread		*td;
+	struct ipsecmb_softc	*sc;
+	int			cpu;
+	int			inflight;
+	bool			sleeping;
+	bool			stop;
+	bool			ready;
+	bool			running;
+} __aligned(CACHE_LINE_SIZE);
+
+struct ipsecmb_softc {
+	device_t		dev;
+	int32_t			cid;
+	int			nworkers;
+	struct ipsecmb_worker	*workers;
+	IMB_MGR			*setup_mgr;	/* key setup in newsession */
+	void			*setup_mem;
+	struct mtx		setup_mtx;
+	uma_zone_t		req_zone;
+	IMB_ARCH		arch;
+	uint64_t		features;
+	counter_u64_t		jobs;
+	counter_u64_t		flushes;
+	counter_u64_t		bounces;
+	counter_u64_t		errors;
+	counter_u64_t		enomem;
+	counter_u64_t		auth_failures;
+	int			last_status;	/* IMB_STATUS of the last failed job */
+	int			last_errno;	/* imb_get_errno() after it */
+};
+
+static const char *
+ipsecmb_arch_name(IMB_ARCH arch)
+{
+	switch (arch) {
+	case IMB_ARCH_SSE:
+		return ("SSE");
+	case IMB_ARCH_AVX2:
+		return ("AVX2");
+	case IMB_ARCH_AVX512:
+		return ("AVX-512");
+	default:
+		return ("none");
+	}
+}
+
+/* Memory for a job manager; allocated before entering an FPU section. */
+static void *
+ipsecmb_mgr_alloc(void)
+{
+	return (malloc(imb_get_mb_mgr_size() + 64, M_IPSECMB, M_WAITOK | M_ZERO));
+}
+
+static void
+ipsecmb_mgr_free(void *mem)
+{
+	if (mem == NULL)
+		return;
+	explicit_bzero(mem, imb_get_mb_mgr_size() + 64);
+	free(mem, M_IPSECMB);
+}
+
+/*
+ * Initialise a job manager in memory from ipsecmb_mgr_alloc(). The caller
+ * holds an FPU context (possibly a critical section): no sleeping here.
+ */
+static IMB_MGR *
+ipsecmb_mgr_init(struct ipsecmb_softc *sc, void *mem, IMB_ARCH *archp)
+{
+	IMB_MGR *mgr;
+
+	mgr = imb_set_pointers_mb_mgr((void *)roundup2((uintptr_t)mem, 64), 0, 1);
+	if (mgr == NULL)
+		return (NULL);
+	switch (ipsecmb_arch_tunable) {
+	case 1:
+		init_mb_mgr_sse(mgr);
+		*archp = IMB_ARCH_SSE;
+		break;
+	case 2:
+		init_mb_mgr_avx2(mgr);
+		*archp = IMB_ARCH_AVX2;
+		break;
+	case 3:
+		init_mb_mgr_avx512(mgr);
+		*archp = IMB_ARCH_AVX512;
+		break;
+	default:
+		init_mb_mgr_auto(mgr, archp);
+		break;
+	}
+	if (imb_get_errno(mgr) != 0 ||
+	    ((mgr->features & IMB_FEATURE_SELF_TEST) != 0 &&
+	    (mgr->features & IMB_FEATURE_SELF_TEST_PASS) == 0))
+		return (NULL);
+	return (mgr);
+}
+
+/* ------------------------------------------------------------------ */
+/* Sessions                                                            */
+/* ------------------------------------------------------------------ */
+
+static IMB_HASH_ALG
+ipsecmb_hmac_alg(int alg, u_int *full)
+{
+	switch (alg) {
+	case CRYPTO_SHA1_HMAC:
+		*full = IMB_SHA1_DIGEST_SIZE_IN_BYTES;
+		return (IMB_AUTH_HMAC_SHA_1);
+	case CRYPTO_SHA2_256_HMAC:
+		*full = IMB_SHA256_DIGEST_SIZE_IN_BYTES;
+		return (IMB_AUTH_HMAC_SHA_256);
+	case CRYPTO_SHA2_384_HMAC:
+		*full = IMB_SHA384_DIGEST_SIZE_IN_BYTES;
+		return (IMB_AUTH_HMAC_SHA_384);
+	case CRYPTO_SHA2_512_HMAC:
+		*full = IMB_SHA512_DIGEST_SIZE_IN_BYTES;
+		return (IMB_AUTH_HMAC_SHA_512);
+	default:
+		*full = 0;
+		return (IMB_AUTH_NULL);
+	}
+}
+
+/* The library accepts the full HMAC or its IPsec truncation (RFC 2404, 4868). */
+static bool
+ipsecmb_hmac_mlen_ok(u_int mlen, u_int full)
+{
+	return (mlen == 0 || mlen == full || mlen == full / 2 ||
+	    (full == IMB_SHA1_DIGEST_SIZE_IN_BYTES && mlen == 12));
+}
+
+static bool
+ipsecmb_aes_klen_ok(int klen)
+{
+	return (klen == 16 || klen == 24 || klen == 32);
+}
+
+static int
+ipsecmb_probesession(device_t dev, const struct crypto_session_params *csp)
+{
+	u_int full;
+
+	if ((csp->csp_flags & ~(CSP_F_SEPARATE_AAD | CSP_F_ESN)) != 0)
+		return (EINVAL);
+	/* Keys must come with the session; per-request keys are handled but slow. */
+	if (csp->csp_cipher_klen != 0 && csp->csp_cipher_key == NULL)
+		return (EINVAL);
+	if (csp->csp_auth_klen != 0 && csp->csp_auth_key == NULL)
+		return (EINVAL);
+
+	switch (csp->csp_mode) {
+	case CSP_MODE_AEAD:
+		if ((csp->csp_flags & CSP_F_ESN) != 0)
+			return (EINVAL);
+		switch (csp->csp_cipher_alg) {
+		case CRYPTO_AES_NIST_GCM_16:
+			if (!ipsecmb_aes_klen_ok(csp->csp_cipher_klen) ||
+			    csp->csp_ivlen != AES_GCM_IV_LEN ||
+			    (csp->csp_auth_mlen != 0 && csp->csp_auth_mlen != IPSECMB_GCM_TAG_LEN))
+				return (EINVAL);
+			break;
+		case CRYPTO_CHACHA20_POLY1305:
+			if (csp->csp_cipher_klen != 32 || csp->csp_ivlen != 12 ||
+			    (csp->csp_auth_mlen != 0 && csp->csp_auth_mlen != POLY1305_HASH_LEN))
+				return (EINVAL);
+			break;
+		default:
+			return (EINVAL);
+		}
+		break;
+	case CSP_MODE_ETA:
+		if (csp->csp_cipher_alg != CRYPTO_AES_CBC ||
+		    !ipsecmb_aes_klen_ok(csp->csp_cipher_klen) ||
+		    ipsecmb_hmac_alg(csp->csp_auth_alg, &full) == IMB_AUTH_NULL ||
+		    csp->csp_auth_klen == 0 ||
+		    !ipsecmb_hmac_mlen_ok(csp->csp_auth_mlen, full))
+			return (EINVAL);
+		break;
+	case CSP_MODE_CIPHER:
+		if ((csp->csp_flags & CSP_F_ESN) != 0 ||
+		    csp->csp_cipher_alg != CRYPTO_AES_CBC ||
+		    !ipsecmb_aes_klen_ok(csp->csp_cipher_klen))
+			return (EINVAL);
+		break;
+	case CSP_MODE_DIGEST:
+		if ((csp->csp_flags & CSP_F_ESN) != 0 ||
+		    ipsecmb_hmac_alg(csp->csp_auth_alg, &full) == IMB_AUTH_NULL ||
+		    csp->csp_auth_klen == 0 ||
+		    !ipsecmb_hmac_mlen_ok(csp->csp_auth_mlen, full))
+			return (EINVAL);
+		break;
+	default:
+		return (EINVAL);
+	}
+	return (CRYPTODEV_PROBE_ACCEL_SOFTWARE);
+}
+
+static struct ipsecmb_keys *
+ipsecmb_keys_alloc(void **memp, int how)
+{
+	void *mem;
+
+	mem = malloc(sizeof(struct ipsecmb_keys) + 64, M_IPSECMB, how | M_ZERO);
+	if (mem == NULL)
+		return (NULL);
+	*memp = mem;
+	return ((struct ipsecmb_keys *)roundup2((uintptr_t)mem, 64));
+}
+
+static void
+ipsecmb_keys_free(void *mem)
+{
+	struct ipsecmb_keys *keys;
+
+	if (mem == NULL)
+		return;
+	keys = (struct ipsecmb_keys *)roundup2((uintptr_t)mem, 64);
+	explicit_bzero(keys, sizeof(*keys));
+	free(mem, M_IPSECMB);
+}
+
+/* Expand the cipher and auth keys. The caller holds an FPU context. */
+static void
+ipsecmb_keys_setup(IMB_MGR *mgr, const struct ipsecmb_session *ses,
+    struct ipsecmb_keys *keys, const void *ckey, const void *akey, int aklen)
+{
+	if (ckey != NULL) {
+		switch (ses->cipher_mode) {
+		case IMB_CIPHER_GCM:
+			if (ses->key_len == 16)
+				IMB_AES128_GCM_PRE(mgr, ckey, &keys->gcm);
+			else if (ses->key_len == 24)
+				IMB_AES192_GCM_PRE(mgr, ckey, &keys->gcm);
+			else
+				IMB_AES256_GCM_PRE(mgr, ckey, &keys->gcm);
+			break;
+		case IMB_CIPHER_CBC:
+			if (ses->key_len == 16)
+				IMB_AES_KEYEXP_128(mgr, ckey, keys->enc, keys->dec);
+			else if (ses->key_len == 24)
+				IMB_AES_KEYEXP_192(mgr, ckey, keys->enc, keys->dec);
+			else
+				IMB_AES_KEYEXP_256(mgr, ckey, keys->enc, keys->dec);
+			break;
+		case IMB_CIPHER_CHACHA20_POLY1305:
+			memcpy(keys->chacha, ckey, sizeof(keys->chacha));
+			break;
+		default:
+			break;
+		}
+	}
+	if (akey != NULL && ses->hash_alg != IMB_AUTH_NULL &&
+	    ses->cipher_mode != IMB_CIPHER_GCM &&
+	    ses->cipher_mode != IMB_CIPHER_CHACHA20_POLY1305)
+		imb_hmac_ipad_opad(mgr, ses->hash_alg, akey, aklen, keys->ipad,
+		    keys->opad);
+}
+
+static int
+ipsecmb_newsession(device_t dev, crypto_session_t cses,
+    const struct crypto_session_params *csp)
+{
+	struct ipsecmb_softc *sc = device_get_softc(dev);
+	struct ipsecmb_session *ses;
+	u_int full = 0;
+	bool fpu_entered;
+
+	ses = crypto_get_driver_session(cses);
+	ses->mode = csp->csp_mode;
+	ses->esn = (csp->csp_flags & CSP_F_ESN) != 0;
+	ses->key_len = csp->csp_cipher_klen;
+	ses->cipher_mode = IMB_CIPHER_NULL;
+	ses->hash_alg = IMB_AUTH_NULL;
+
+	switch (csp->csp_mode) {
+	case CSP_MODE_AEAD:
+		if (csp->csp_cipher_alg == CRYPTO_AES_NIST_GCM_16) {
+			/*
+			 * GCM jobs use IMB_AUTH_AES_GMAC for every key size;
+			 * the _192/_256 variants are for standalone GMAC.
+			 */
+			ses->cipher_mode = IMB_CIPHER_GCM;
+			ses->hash_alg = IMB_AUTH_AES_GMAC;
+		} else {
+			ses->cipher_mode = IMB_CIPHER_CHACHA20_POLY1305;
+			ses->hash_alg = IMB_AUTH_CHACHA20_POLY1305;
+		}
+		ses->mlen = 16;
+		break;
+	case CSP_MODE_ETA:
+		ses->cipher_mode = IMB_CIPHER_CBC;
+		ses->hash_alg = ipsecmb_hmac_alg(csp->csp_auth_alg, &full);
+		ses->mlen = csp->csp_auth_mlen != 0 ? csp->csp_auth_mlen : full;
+		break;
+	case CSP_MODE_CIPHER:
+		ses->cipher_mode = IMB_CIPHER_CBC;
+		break;
+	case CSP_MODE_DIGEST:
+		ses->hash_alg = ipsecmb_hmac_alg(csp->csp_auth_alg, &full);
+		ses->mlen = csp->csp_auth_mlen != 0 ? csp->csp_auth_mlen : full;
+		break;
+	default:
+		return (EINVAL);
+	}
+
+	ses->keys = ipsecmb_keys_alloc(&ses->keys_mem, M_WAITOK);
+
+	mtx_lock(&sc->setup_mtx);
+	if (is_fpu_kern_thread(0)) {
+		fpu_entered = false;
+	} else {
+		fpu_kern_enter(curthread, NULL, FPU_KERN_NOCTX);
+		fpu_entered = true;
+	}
+	ipsecmb_keys_setup(sc->setup_mgr, ses, ses->keys, csp->csp_cipher_key,
+	    csp->csp_auth_key, csp->csp_auth_klen);
+	if (fpu_entered)
+		fpu_kern_leave(curthread, NULL);
+	mtx_unlock(&sc->setup_mtx);
+	return (0);
+}
+
+static void
+ipsecmb_freesession(device_t dev, crypto_session_t cses)
+{
+	struct ipsecmb_session *ses;
+
+	ses = crypto_get_driver_session(cses);
+	ipsecmb_keys_free(ses->keys_mem);
+	ses->keys_mem = NULL;
+	ses->keys = NULL;
+}
+
+/* ------------------------------------------------------------------ */
+/* Requests                                                            */
+/* ------------------------------------------------------------------ */
+
+/* A pointer to [start, start + len) when that range is one segment of the buffer. */
+static uint8_t *
+ipsecmb_contig(struct crypto_buffer *cb, int start, int len)
+{
+	struct crypto_buffer_cursor cc;
+	size_t seglen;
+	void *p;
+
+	crypto_cursor_init(&cc, cb);
+	crypto_cursor_advance(&cc, start);
+	p = crypto_cursor_segment(&cc, &seglen);
+	if (p == NULL || seglen < (size_t)len)
+		return (NULL);
+	return (p);
+}
+
+static void
+ipsecmb_req_free(struct ipsecmb_softc *sc, struct ipsecmb_req *req)
+{
+	if (req->bounce != NULL) {
+		explicit_bzero(req->bounce, req->bounce_len);
+		free(req->bounce, M_IPSECMB);
+	}
+	if (req->aad_alloc != NULL)
+		free(req->aad_alloc, M_IPSECMB);
+	ipsecmb_keys_free(req->tmpkeys_mem);
+	explicit_bzero(req->tag, sizeof(req->tag));
+	uma_zfree(sc->req_zone, req);
+}
+
+static void
+ipsecmb_req_done(struct ipsecmb_softc *sc, struct ipsecmb_req *req, int error)
+{
+	struct cryptop *crp = req->crp;
+
+	if (error == EBADMSG)
+		counter_u64_add(sc->auth_failures, 1);
+	else if (error != 0)
+		counter_u64_add(sc->errors, 1);
+	ipsecmb_req_free(sc, req);
+	crp->crp_etype = error;
+	crypto_done(crp);
+}
+
+/* The AAD as one contiguous block, copied out of the buffer when it is split. */
+static const uint8_t *
+ipsecmb_req_aad(struct ipsecmb_req *req)
+{
+	struct cryptop *crp = req->crp;
+	uint8_t *p;
+
+	if (crp->crp_aad_length == 0)
+		return (req->aad_inline);
+	if (crp->crp_aad != NULL)
+		return (crp->crp_aad);
+	p = ipsecmb_contig(&crp->crp_buf, crp->crp_aad_start, crp->crp_aad_length);
+	if (p != NULL)
+		return (p);
+	if (crp->crp_aad_length <= IPSECMB_AAD_INLINE) {
+		p = req->aad_inline;
+	} else {
+		req->aad_alloc = malloc(crp->crp_aad_length, M_IPSECMB, M_NOWAIT);
+		if (req->aad_alloc == NULL)
+			return (NULL);
+		p = req->aad_alloc;
+	}
+	crypto_copydata(crp, crp->crp_aad_start, crp->crp_aad_length, p);
+	return (p);
+}
+
+/*
+ * Lay the data out for the job. AEAD and cipher-only jobs need the payload
+ * contiguous; ETA and digest jobs need [aad][payload][esn] contiguous, because
+ * the HMAC covers all of it. Use the buffer in place when it already is,
+ * otherwise copy into a bounce buffer (copied back on completion).
+ */
+static int
+ipsecmb_req_layout(struct ipsecmb_softc *sc, struct ipsecmb_req *req,
+    uint8_t **basep, int *hash_offp, int *hash_lenp, int *payload_offp)
+{
+	struct cryptop *crp = req->crp;
+	struct ipsecmb_session *ses = req->ses;
+	int aadlen, plen, esnlen;
+	bool hashed_aad;
+	uint8_t *p;
+
+	plen = crp->crp_payload_length;
+	hashed_aad = (ses->mode == CSP_MODE_ETA || ses->mode == CSP_MODE_DIGEST);
+	aadlen = hashed_aad ? crp->crp_aad_length : 0;
+	esnlen = (hashed_aad && ses->esn) ? IPSECMB_ESN_LEN : 0;
+
+	if (!hashed_aad || (aadlen == 0 && esnlen == 0)) {
+		p = ipsecmb_contig(&crp->crp_buf, crp->crp_payload_start, plen);
+		if (p != NULL || plen == 0) {
+			*basep = p != NULL ? p : req->tag;
+			*hash_offp = 0;
+			*hash_lenp = plen;
+			*payload_offp = 0;
+			return (0);
+		}
+	} else if (esnlen == 0 && crp->crp_aad == NULL &&
+	    crp->crp_aad_start + aadlen == crp->crp_payload_start) {
+		p = ipsecmb_contig(&crp->crp_buf, crp->crp_aad_start, aadlen + plen);
+		if (p != NULL) {
+			*basep = p;
+			*hash_offp = 0;
+			*hash_lenp = aadlen + plen;
+			*payload_offp = aadlen;
+			return (0);
+		}
+	}
+
+	req->bounce_len = aadlen + plen + esnlen;
+	req->bounce = malloc(MAX(req->bounce_len, 1), M_IPSECMB, M_NOWAIT);
+	if (req->bounce == NULL)
+		return (ENOMEM);
+	counter_u64_add(sc->bounces, 1);
+	if (aadlen != 0) {
+		if (crp->crp_aad != NULL)
+			memcpy(req->bounce, crp->crp_aad, aadlen);
+		else
+			crypto_copydata(crp, crp->crp_aad_start, aadlen, req->bounce);
+	}
+	crypto_copydata(crp, crp->crp_payload_start, plen, req->bounce + aadlen);
+	if (esnlen != 0)
+		memcpy(req->bounce + aadlen + plen, crp->crp_esn, esnlen);
+	req->bounce_payload_off = aadlen;
+	*basep = req->bounce;
+	*hash_offp = 0;
+	*hash_lenp = aadlen + plen + esnlen;
+	*payload_offp = aadlen;
+	return (0);
+}
+
+/* Fill an IMB_JOB from a request. The worker thread holds the FPU. */
+static int
+ipsecmb_fill_job(struct ipsecmb_worker *w, struct ipsecmb_req *req, IMB_JOB *job)
+{
+	struct cryptop *crp = req->crp;
+	struct ipsecmb_session *ses = req->ses;
+	const struct crypto_session_params *csp;
+	const uint8_t *aad = NULL;
+	uint8_t *base;
+	int error, hash_off, hash_len, payload_off;
+	bool encrypt;
+
+	csp = crypto_get_params(crp->crp_session);
+	encrypt = CRYPTO_OP_IS_ENCRYPT(crp->crp_op);
+
+	/* Per-request keys: expand them for this request only. */
+	req->keys = ses->keys;
+	if (crp->crp_cipher_key != NULL || crp->crp_auth_key != NULL) {
+		req->keys = ipsecmb_keys_alloc(&req->tmpkeys_mem, M_NOWAIT);
+		if (req->keys == NULL)
+			return (ENOMEM);
+		memcpy(req->keys, ses->keys, sizeof(*req->keys));
+		ipsecmb_keys_setup(w->mgr, ses, req->keys, crp->crp_cipher_key,
+		    crp->crp_auth_key, csp->csp_auth_klen);
+	}
+
+	if (ses->cipher_mode == IMB_CIPHER_CBC &&
+	    (crp->crp_payload_length % AES_BLOCK_LEN) != 0)
+		return (EINVAL);
+	/*
+	 * The job API takes at most 64 KiB - 1 for CBC and for HMAC. IPsec
+	 * packets never come close; larger /dev/crypto requests get EFBIG.
+	 */
+	if (ses->cipher_mode == IMB_CIPHER_CBC &&
+	    crp->crp_payload_length > IPSECMB_MAX_LEN)
+		return (EFBIG);
+	if ((ses->mode == CSP_MODE_ETA || ses->mode == CSP_MODE_DIGEST) &&
+	    crp->crp_aad_length + crp->crp_payload_length +
+	    (ses->esn ? IPSECMB_ESN_LEN : 0) > IPSECMB_MAX_LEN)
+		return (EFBIG);
+
+	if (ses->mode == CSP_MODE_AEAD) {
+		aad = ipsecmb_req_aad(req);
+		if (aad == NULL)
+			return (ENOMEM);
+	}
+	error = ipsecmb_req_layout(w->sc, req, &base, &hash_off, &hash_len,
+	    &payload_off);
+	if (error != 0)
+		return (error);
+	if (ses->cipher_mode != IMB_CIPHER_NULL)
+		crypto_read_iv(crp, req->iv);
+
+	/*
+	 * cipher_start_src_offset_in_bytes applies to src only: the library
+	 * writes the cipher output at dst itself, so dst is the payload.
+	 */
+	job->src = base;
+	job->dst = base + payload_off;
+	job->cipher_mode = ses->cipher_mode;
+	job->hash_alg = ses->hash_alg;
+	job->cipher_direction = encrypt ? IMB_DIR_ENCRYPT : IMB_DIR_DECRYPT;
+	/* Encrypt-then-MAC: hash the ciphertext, before decrypting it. */
+	job->chain_order = encrypt ? IMB_ORDER_CIPHER_HASH : IMB_ORDER_HASH_CIPHER;
+	job->key_len_in_bytes = ses->key_len;
+	job->cipher_start_src_offset_in_bytes = payload_off;
+	job->msg_len_to_cipher_in_bytes = crp->crp_payload_length;
+	job->hash_start_src_offset_in_bytes = hash_off;
+	job->msg_len_to_hash_in_bytes = hash_len;
+	job->iv = req->iv;
+	job->iv_len_in_bytes = csp->csp_ivlen;
+	job->auth_tag_output = req->tag;
+	job->auth_tag_output_len_in_bytes = ses->mlen;
+	job->user_data = req;
+
+	switch (ses->cipher_mode) {
+	case IMB_CIPHER_GCM:
+		job->enc_keys = &req->keys->gcm;
+		job->dec_keys = &req->keys->gcm;
+		job->hash_start_src_offset_in_bytes = payload_off;
+		job->msg_len_to_hash_in_bytes = crp->crp_payload_length;
+		job->u.GCM.aad = aad;
+		job->u.GCM.aad_len_in_bytes = crp->crp_aad_length;
+		job->u.GCM.ctx = NULL;
+		break;
+	case IMB_CIPHER_CHACHA20_POLY1305:
+		job->enc_keys = req->keys->chacha;
+		job->dec_keys = req->keys->chacha;
+		job->hash_start_src_offset_in_bytes = payload_off;
+		job->msg_len_to_hash_in_bytes = crp->crp_payload_length;
+		job->u.CHACHA20_POLY1305.aad = aad;
+		job->u.CHACHA20_POLY1305.aad_len_in_bytes = crp->crp_aad_length;
+		job->u.CHACHA20_POLY1305.ctx = NULL;
+		break;
+	case IMB_CIPHER_CBC:
+		job->enc_keys = req->keys->enc;
+		job->dec_keys = req->keys->dec;
+		break;
+	default:
+		job->enc_keys = NULL;
+		job->dec_keys = NULL;
+		job->msg_len_to_cipher_in_bytes = 0;
+		job->iv_len_in_bytes = 0;
+		break;
+	}
+	if (ses->mode == CSP_MODE_ETA || ses->mode == CSP_MODE_DIGEST) {
+		job->u.HMAC._hashed_auth_key_xor_ipad = req->keys->ipad;
+		job->u.HMAC._hashed_auth_key_xor_opad = req->keys->opad;
+	}
+	if (ses->mode == CSP_MODE_CIPHER) {
+		job->hash_alg = IMB_AUTH_NULL;
+		job->msg_len_to_hash_in_bytes = 0;
+		job->auth_tag_output = NULL;
+		job->auth_tag_output_len_in_bytes = 0;
+	}
+	return (0);
+}
+
+/* A job came back from the manager: copy results out and finish the request. */
+static void
+ipsecmb_complete_job(struct ipsecmb_worker *w, IMB_JOB *job)
+{
+	struct ipsecmb_req *req = job->user_data;
+	struct ipsecmb_session *ses = req->ses;
+	struct cryptop *crp = req->crp;
+	uint8_t want[IPSECMB_TAG_MAX];
+	int error = 0;
+
+	w->inflight--;
+	if (job->status != IMB_STATUS_COMPLETED) {
+		w->sc->last_status = job->status;
+		w->sc->last_errno = imb_get_errno(w->mgr);
+		ipsecmb_req_done(w->sc, req, EIO);
+		return;
+	}
+	if (req->bounce != NULL && ses->mode != CSP_MODE_DIGEST)
+		crypto_copyback(crp, crp->crp_payload_start, crp->crp_payload_length,
+		    req->bounce + req->bounce_payload_off);
+	if (ses->mode != CSP_MODE_CIPHER) {
+		if ((crp->crp_op & CRYPTO_OP_VERIFY_DIGEST) != 0 ||
+		    (ses->mode == CSP_MODE_AEAD && !CRYPTO_OP_IS_ENCRYPT(crp->crp_op))) {
+			crypto_copydata(crp, crp->crp_digest_start, ses->mlen, want);
+			if (timingsafe_bcmp(want, req->tag, ses->mlen) != 0)
+				error = EBADMSG;
+			explicit_bzero(want, sizeof(want));
+		} else {
+			crypto_copyback(crp, crp->crp_digest_start, ses->mlen, req->tag);
+		}
+	}
+	ipsecmb_req_done(w->sc, req, error);
+}
+
+static void
+ipsecmb_drain_completed(struct ipsecmb_worker *w, IMB_JOB *job)
+{
+	while (job != NULL) {
+		ipsecmb_complete_job(w, job);
+		job = IMB_GET_COMPLETED_JOB(w->mgr);
+	}
+}
+
+static void
+ipsecmb_flush(struct ipsecmb_worker *w)
+{
+	IMB_JOB *job;
+
+	if (w->inflight == 0)
+		return;
+	counter_u64_add(w->sc->flushes, 1);
+	while ((job = IMB_FLUSH_JOB(w->mgr)) != NULL)
+		ipsecmb_drain_completed(w, job);
+}
+
+static void
+ipsecmb_submit(struct ipsecmb_worker *w, struct ipsecmb_req *req)
+{
+	IMB_JOB *job;
+	int error;
+
+	job = IMB_GET_NEXT_JOB(w->mgr);
+	error = ipsecmb_fill_job(w, req, job);
+	if (error != 0) {
+		/* The slot is simply reused by the next request. */
+		ipsecmb_req_done(w->sc, req, error);
+		return;
+	}
+	counter_u64_add(w->sc->jobs, 1);
+	w->inflight++;
+	job = IMB_SUBMIT_JOB(w->mgr);
+	ipsecmb_drain_completed(w, job);
+}
+
+static void
+ipsecmb_worker_main(void *arg)
+{
+	struct ipsecmb_worker *w = arg;
+	struct ipsecmb_softc *sc = w->sc;
+	struct ipsecmb_reqq batch;
+	struct ipsecmb_req *req;
+	IMB_ARCH arch;
+	sbintime_t wait;
+
+	thread_lock(curthread);
+	sched_bind(curthread, w->cpu);
+	thread_unlock(curthread);
+	fpu_kern_thread(0);
+
+	w->mgr_mem = ipsecmb_mgr_alloc();
+	w->mgr = ipsecmb_mgr_init(sc, w->mgr_mem, &arch);
+	if (w->mgr == NULL) {
+		ipsecmb_mgr_free(w->mgr_mem);
+		w->mgr_mem = NULL;
+	}
+	mtx_lock(&w->mtx);
+	w->ready = true;
+	w->running = (w->mgr != NULL);
+	wakeup(&w->ready);
+	if (!w->running) {
+		w->td = NULL;
+		mtx_unlock(&w->mtx);
+		kthread_exit();
+	}
+
+	STAILQ_INIT(&batch);
+	for (;;) {
+		while (STAILQ_EMPTY(&w->queue) && !w->stop) {
+			if (w->inflight > 0) {
+				/* Wait a little for more work, then flush what is pending. */
+				wait = SBT_1US * MAX(ipsecmb_flush_usec, 1);
+				w->sleeping = true;
+				msleep_sbt(w, &w->mtx, 0, "imbwait", wait, SBT_1US, 0);
+				w->sleeping = false;
+				if (STAILQ_EMPTY(&w->queue)) {
+					mtx_unlock(&w->mtx);
+					ipsecmb_flush(w);
+					mtx_lock(&w->mtx);
+				}
+				continue;
+			}
+			w->sleeping = true;
+			msleep(w, &w->mtx, 0, "imbidle", 0);
+			w->sleeping = false;
+		}
+		if (STAILQ_EMPTY(&w->queue) && w->stop)
+			break;
+		STAILQ_CONCAT(&batch, &w->queue);
+		mtx_unlock(&w->mtx);
+
+		while ((req = STAILQ_FIRST(&batch)) != NULL) {
+			STAILQ_REMOVE_HEAD(&batch, link);
+			ipsecmb_submit(w, req);
+			if (ipsecmb_sync)
+				ipsecmb_flush(w);
+		}
+		if (ipsecmb_flush_usec <= 0)
+			ipsecmb_flush(w);
+		mtx_lock(&w->mtx);
+	}
+	mtx_unlock(&w->mtx);
+	ipsecmb_flush(w);
+
+	mtx_lock(&w->mtx);
+	ipsecmb_mgr_free(w->mgr_mem);
+	w->mgr = NULL;
+	w->mgr_mem = NULL;
+	w->running = false;
+	w->td = NULL;
+	wakeup(&w->td);
+	mtx_unlock(&w->mtx);
+	kthread_exit();
+}
+
+static int
+ipsecmb_process(device_t dev, struct cryptop *crp, int hint)
+{
+	struct ipsecmb_softc *sc = device_get_softc(dev);
+	struct ipsecmb_worker *w;
+	struct ipsecmb_req *req;
+	bool wake;
+
+	req = uma_zalloc(sc->req_zone, M_NOWAIT | M_ZERO);
+	if (req == NULL) {
+		counter_u64_add(sc->enomem, 1);
+		crp->crp_etype = ENOMEM;
+		crypto_done(crp);
+		return (0);
+	}
+	req->crp = crp;
+	req->ses = crypto_get_driver_session(crp->crp_session);
+
+	w = &sc->workers[curcpu % sc->nworkers];
+	mtx_lock(&w->mtx);
+	STAILQ_INSERT_TAIL(&w->queue, req, link);
+	wake = w->sleeping;
+	mtx_unlock(&w->mtx);
+	if (wake)
+		wakeup_one(w);
+	return (0);
+}
