diff --git a/stand/defaults/loader.conf b/stand/defaults/loader.conf
index e9ce5a109..d64de3d20 100644
--- a/stand/defaults/loader.conf
+++ b/stand/defaults/loader.conf
@@ -28,8 +28,8 @@ bitmap_load="NO"		# Set this to YES if you want splash screen!
 bitmap_name="splash.bmp"	# Set this to the name of the file
 bitmap_type="splash_image_data" # and place it on the module_path
 # Set boot_mute=YES to load these
-splash="/boot/images/freebsd-logo-rev.png"
-shutdown_splash="/boot/images/freebsd-logo-rev.png"
+splash="/boot/images/freesense-logo-rev.png"
+shutdown_splash="/boot/images/freesense-logo-rev.png"
 
 ###  Screen saver modules  ###################################
 # This is best done in rc.conf
@@ -207,4 +207,5 @@ loader_brand="FreeSense"
 hw.usb.no_pf="1"
 net.isr.maxthreads="-1"
 loader_menu_title="Welcome to FreeSense"
+boot_mute="YES"
 net.pf.request_maxcount="400000"
diff --git a/stand/forth/brand-fbsd.4th b/stand/forth/brand-fbsd.4th
