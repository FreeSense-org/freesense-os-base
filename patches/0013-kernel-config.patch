index 000000000..382a7774e
--- /dev/null
+++ b/sys/conf/FREESENSE-COMMON
@@ -0,0 +1,72 @@
+# FreeSense kernel: the options and pseudo-devices every architecture shares.
+# Included by FREESENSE and FREESENSE-DEBUG after GENERIC. Copyright (c) 2026 The FreeSense Project, Apache-2.0.
+
+nooptions	MAC			# no TrustedBSD MAC framework
+nooptions	KDB_TRACE
+options 	DDB
+
+# Storage and filesystems
+options 	GEOM_ELI		# disk encryption
+options 	GEOM_MIRROR
+options 	GEOM_UZIP		# compressed images (live media)
+options 	TMPFS
+options 	NULLFS
+options 	PPS_SYNC		# PPS time sources
+options 	KDTRACE_MIB_SDT		# keep the MIB probes in release kernels
+
+# Network pseudo-devices
+device		gre
+device		if_bridge
+device		carp
+device		lagg
+device		vxlan
+device		enc			# IPsec packet inspection
+device		pf
+device		pflog
+device		pfsync
+options 	IPSTEALTH		# hide this router from traceroute (setting)
+options 	MROUTING		# multicast forwarding
+options 	RSS			# receive-side scaling for multi-queue NICs
+
+# IPsec
+options 	IPSEC
+options 	TCP_SIGNATURE		# TCP-MD5 for routing sessions
+
+# Traffic shaping
+options 	ALTQ
+options 	ALTQ_CBQ
+options 	ALTQ_RED
+options 	ALTQ_RIO
+options 	ALTQ_HFSC
+options 	ALTQ_PRIQ
+options 	ALTQ_FAIRQ
+options 	ALTQ_NOPCC
+options 	ALTQ_CODEL
+
+# Netgraph: what PPPoE, PPTP and L2TP clients and multilink PPP need
+options 	NETGRAPH
+options 	NETGRAPH_ETHER
+options 	NETGRAPH_SOCKET
+options 	NETGRAPH_KSOCKET
+options 	NETGRAPH_IFACE
+options 	NETGRAPH_VLAN
+options 	NETGRAPH_PPP
+options 	NETGRAPH_PPPOE
+options 	NETGRAPH_PPTPGRE
+options 	NETGRAPH_L2TP
+options 	NETGRAPH_ASYNC
+options 	NETGRAPH_BPF
+options 	NETGRAPH_ETF
+options 	NETGRAPH_ONE2MANY
+options 	NETGRAPH_TEE
+options 	NETGRAPH_TCPMSS
+options 	NETGRAPH_VJC
+options 	NETGRAPH_DEFLATE
+options 	NETGRAPH_PRED1
+options 	NETGRAPH_MPPC_ENCRYPTION
+
+# Console and virtual machines
+device		virtio_console
+
+# AES-NI runs as a module so ipsecmb and the crypto framework can pick the best provider
+nodevice	aesni
