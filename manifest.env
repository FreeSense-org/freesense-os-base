# FreeSense FreeBSD-src change-set manifest (sourced by apply.sh + the builder).
#
# The patches under patches/ are applied, in sorted order, on top of a STOCK
# checkout of freebsd/freebsd-src. This replaces carrying a full fork
# (FreeSense-org/freebsd-src) — see README.md.

UPSTREAM_URL="https://github.com/freebsd/freebsd-src.git"

# The upstream commit the change-set is applied to is NOT kept here: the
# pinned FreeBSD source commit in config/freebsd-16.json (freebsd_source.commit,
# updated by the pin workflow) is the single source of truth. Left empty,
# apply.sh reads it from that file; CI builds set it to the build's pinned
# commit (scripts/runner/worker-common.sh). Set it only to override locally.
UPSTREAM_REF=""
