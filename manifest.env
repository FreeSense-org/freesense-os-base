# FreeSense FreeBSD-src change-set manifest (sourced by apply.sh + the builder).
#
# The patches under patches/ are applied, in sorted order, on top of a STOCK
# checkout of freebsd/freebsd-src pinned at UPSTREAM_REF. This replaces carrying
# a full fork (FreeSense-org/freebsd-src) — see README.md.

UPSTREAM_URL="https://github.com/freebsd/freebsd-src.git"

# The exact upstream commit the change-set is built against = the merge-base of
# pfSense's devel-main and freebsd/main (FreeBSD-CURRENT, 2026-03-26
# "manuals: System message vs kernel message"). No release tag — pin by SHA.
# Bump this only when deliberately rebasing onto newer FreeBSD (see README).
UPSTREAM_REF="60382b4a04fa39e9bf65b964b1b7b4bed6eaa56a"
